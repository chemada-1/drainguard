void setup() {
  Serial.begin(9600);
  while (!Serial);

  preferences.begin("wifi", true);
  String savedSSID = preferences.getString("ssid", "");
  String savedPass = preferences.getString("pass", "");
  // Dynamic AP credentials with defaults
  String apSSID = preferences.getString("ap_ssid", "DrainGuard-Offline");
  String apPass = preferences.getString("ap_pass", "12345678");
  preferences.end();

  if (savedSSID != "") {
    WiFi.mode(WIFI_STA); 
    WiFi.begin(savedSSID.c_str(), savedPass.c_str());
    int retries = 0;
    while (WiFi.status() != WL_CONNECTED && retries < 20) {
      delay(500);
      retries++;
    }
  }

  if (WiFi.status() == WL_CONNECTED) {
    WiFi.softAPdisconnect(true);
    WiFi.mode(WIFI_STA); 
    networkStatus = "Connected to Router: " + WiFi.localIP().toString();
    Serial.println("Online Mode Active. AP Shutdown.");
  } else {
    WiFi.mode(WIFI_AP); 
    WiFi.softAP(apSSID.c_str(), apPass.c_str());
    
    // Start DNS server for Captive Portal
    isCaptivePortal = true;
    dnsServer.start(DNS_PORT, "*", WiFi.softAPIP());
    
    networkStatus = "AP Fallback Active. Connect to configure.";
    Serial.println("Offline Mode Active. AP Broadcasting.");
  }

  if (MDNS.begin("drainguard")) {
    MDNS.addService("http", "tcp", 80);
  }

  const char* headerKeys[] = {"Cookie"};
  server.collectHeaders(headerKeys, 1);

  server.on("/", handleRoot);
  server.on("/auth", HTTP_POST, handleAuth);
  server.on("/logout", handleLogout);
  server.on("/dashboard", handleDashboard); 
  server.on("/data", handleData); 
  server.on("/api/config", HTTP_POST, handleApiConfig); // New Backend Route
  server.on("/admin", handleAdmin); 
  server.on("/save", HTTP_POST, handleSaveCredentials); 
  server.onNotFound(handleNotFound); // Captive Portal redirect
  server.begin();

  udp.begin(udpPort);

  LoRa.setPins(ss, rst, dio0);
  
  if (!LoRa.begin(433E6)) {
    Serial.println("[ERROR] Starting LoRa failed! Check physical wiring.");
    while (1);
  }
  Serial.println("[SUCCESS] LoRa Initialized. Entering passive listen mode...");
}

void broadcastUDP(String data, int rssi) {
  String jsonPayload = "{\"data\":\"" + data + "\", \"rssi\":" + String(rssi) + "}";
  udp.beginPacket(IPAddress(255, 255, 255, 255), udpPort);
  udp.print(jsonPayload);
  udp.endPacket();
}

void loop() {
  if (isCaptivePortal) {
    dnsServer.processNextRequest(); // Required for Captive Portal to function
  }
  
  server.handleClient();

  unsigned long currentMillis = millis();
  if (currentMillis - lastDebugTime >= 5000) {
    Serial.println("[DEBUG] LoRa module is actively listening for incoming packets...");
    
    // NEW: Send a network heartbeat so the PC knows the ESP32 is still plugged in
    broadcastUDP("SYS:HEARTBEAT", 0);
    
    lastDebugTime = currentMillis;
  }

  int packetSize = LoRa.parsePacket();
  if (packetSize) {
    String incoming = "";
    while (LoRa.available()) {
      incoming += (char)LoRa.read();
    }

    lastData = incoming;
    lastRSSI = LoRa.packetRssi();

    Serial.println("\n[>>>] INCOMING LORA PACKET CAUGHT [<<<]");
    Serial.print("Raw Payload: ");
    Serial.println(incoming);
    Serial.print("Signal Strength (RSSI): ");
    Serial.print(lastRSSI);
    Serial.print(" dBm | SNR: ");
    Serial.println(LoRa.packetSnr());
    Serial.println("----------------------------------------\n");

    broadcastUDP(incoming, lastRSSI);
  }
}