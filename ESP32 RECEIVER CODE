// --- SECURITY HELPERS ---
bool isAuthenticated() {
  if (server.hasHeader("Cookie")) {
    String cookie = server.header("Cookie");
    if (cookie.indexOf("DG_SESSION=1") != -1) {
      return true;
    }
  }
  return false;
}

// --- WEB ROUTING ---
void handleRoot() {
  if (isAuthenticated()) {
    server.sendHeader("Location", "/admin", true);
    server.send(302);
    return;
  }
  server.send(200, "text/html", login_html);
}

void handleAuth() {
  if (server.hasArg("email") && server.hasArg("password")) {
    if (server.arg("email") == adminEmail && server.arg("password") == adminPass) {
      server.sendHeader("Set-Cookie", "DG_SESSION=1; Path=/; HttpOnly");
      server.sendHeader("Location", "/admin", true);
      server.send(302);
      return;
    }
  }
  server.send(401, "text/html", "<h2>Invalid Login</h2><a href='/'>Try Again</a>");
}

void handleLogout() {
  server.sendHeader("Set-Cookie", "DG_SESSION=0; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT");
  server.sendHeader("Location", "/", true);
  server.send(302);
}

void handleDashboard() {
  server.send(200, "text/html", dashboard_html);
}

void handleData() {
  server.sendHeader("Access-Control-Allow-Origin", "*");
  String json = "{\"lastData\":\"" + lastData + "\", \"lastRSSI\":" + String(lastRSSI) + "}";
  server.send(200, "application/json", json);
}

// NEW: Endpoint to receive configuration commands from Python Flask
void handleApiConfig() {
  if (server.hasArg("plain") == false) {
    server.send(400, "application/json", "{\"error\": \"No payload received\"}");
    return;
  }
  
  String body = server.arg("plain");
  String new_sta_ssid = extractJsonValue(body, "sta_ssid");
  String new_sta_pass = extractJsonValue(body, "sta_pass");
  String new_ap_ssid = extractJsonValue(body, "ap_ssid");
  String new_ap_pass = extractJsonValue(body, "ap_pass");

  preferences.begin("wifi", false);
  if (new_sta_ssid != "") preferences.putString("ssid", new_sta_ssid);
  if (new_sta_pass != "") preferences.putString("pass", new_sta_pass);
  if (new_ap_ssid != "") preferences.putString("ap_ssid", new_ap_ssid);
  if (new_ap_pass != "") preferences.putString("ap_pass", new_ap_pass);
  preferences.end();

  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.send(200, "application/json", "{\"success\": true}");
  
  delay(1500);
  ESP.restart(); // Reboot to apply the new network settings
}

void handleAdmin() {
  if (!isAuthenticated()) {
    server.sendHeader("Location", "/", true);
    server.send(302);
    return;
  }
  String html = String(admin_html);
  html.replace("%NETWORK_STATUS%", networkStatus);
  server.send(200, "text/html", html);
}

void handleSaveCredentials() {
  if (!isAuthenticated()) {
    server.sendHeader("Location", "/", true);
    server.send(302);
    return;
  }

  if (server.hasArg("ssid") && server.hasArg("pass")) {
    preferences.begin("wifi", false);
    preferences.putString("ssid", server.arg("ssid"));
    preferences.putString("pass", server.arg("pass"));
    preferences.end();
    
    server.send(200, "text/html", "<h2 style='font-family:sans-serif; text-align:center; padding: 20px;'>Credentials Saved! Rebooting...</h2>");
    delay(2000);
    ESP.restart(); 
  }
}

